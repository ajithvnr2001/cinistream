# Firebase AI Logic authenticates via App Check; no client-side GEMINI_API_KEY is required.

# Optional: NordVPN Access Token for 1-tap NordVPN SOCKS5 / NordLynx login.
# Set this securely in the AI Studio Secrets panel (never commit real tokens here).
NORDVPN_ACCESS_TOKEN=YOUR_NORDVPN_ACCESS_TOKEN

# Optional: OpenSubtitles REST API v1 key for in-app Online Subtitle Search.
# Set this securely in the AI Studio Secrets panel (never commit real keys here).
OPENSUBTITLES_API_KEY=YOUR_OPENSUBTITLES_API_KEY
